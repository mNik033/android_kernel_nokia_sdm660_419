# Fingerprint
CONFIG_FINGERPRINT_GF5288=y

# Platform
CONFIG_FIH_DRAGON=y
CONFIG_FIH_SDM630_SDM660_PROJS=y

# Touchscreen
CONFIG_TOUCHSCREEN_GT9XX=y
CONFIG_TOUCHSCREEN_GT9XX_UPDATE=y
CONFIG_TOUCHSCREEN_GT9XX_TOOL=y

# Display
# CONFIG_PXLW_IRIS3 is not set
# CONFIG_FB_MSM_MDSS_HDMI_PANEL is not set
# CONFIG_FB_MSM_MDSS_DP_PANEL is not set

# Storage (DRG uses eMMC, not UFS)
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_PHY_QCOM_UFS is not set
