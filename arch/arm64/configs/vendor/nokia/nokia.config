# A/B
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# BPF
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_BPF=y

# Camera
# CONFIG_MSMB_CAMERA is not set
CONFIG_MSMB_CAMERA_LEGACY=y

# Cpufreq
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=n
CONFIG_CPU_FREQ_GOV_INTERACTIVE=n
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=n

# Debug
# CONFIG_QCOM_PRESERVE_MEM is not set

# Filesystems
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y

# Haptics
# CONFIG_INPUT_QTI_HAPTICS is not set
CONFIG_LEDS_QPNP_HAPTICS=y

# Input
CONFIG_INPUT_STMVL53L0=y

# ION
CONFIG_ION_LEGACY=y

# Misc
CONFIG_BLK_CGROUP=y
CONFIG_CRYPTO_CRC32_ARM64_CE=y
CONFIG_CRYPTO_ECHAINIV=y
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_BFQ_GROUP_IOSCHED is not set
# CONFIG_IOSCHED_CFQ is not set
# CONFIG_CFQ_GROUP_IOSCHED is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
CONFIG_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_DEADLINE=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_OVERLAY_FS=y
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_THIN_ARCHIVES=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# NFC
CONFIG_NFC=y

# OTG
CONFIG_USB_MSM_OTG=y
CONFIG_USB_OTG=y

# Platform
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
CONFIG_STRIP_ASM_SYMS=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# RCU
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y

# VDSO
CONFIG_COMPAT_VDSO=y

# Wi-Fi
CONFIG_QCA_CLD_WLAN=y

# Wireguard
CONFIG_WIREGUARD=y

# Networking (BBR + FQ pacing default; CUBIC & FQ_CODEL available)
CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_TCP_CONG_BIC is not set
CONFIG_TCP_CONG_CUBIC=y
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# CONFIG_DEFAULT_PFIFO_FAST is not set

# WERROR
CONFIG_CC_WERROR=n

# Disable debugging configs
# CONFIG_SKY2 is not set
# CONFIG_SMSC911X is not set
# CONFIG_INPUT_HBTP_INPUT is not set
# CONFIG_SERIAL_MSM is not set
# CONFIG_SERIAL_MSM_CONSOLE is not set
# CONFIG_PINCTRL_MSM8998 is not set
# CONFIG_MSM_QBT1000 is not set
# CONFIG_CGROUP_DEBUG is not set
# CONFIG_UTS_NS is not set
# CONFIG_VIDEO_ADV_DEBUG is not set
# CONFIG_MSM_CAMERA_DEBUG is not set
# CONFIG_MSMB_CAMERA_DEBUG is not set
# CONFIG_SDE_ROTATOR_EVTLOG_DEBUG is not set
# CONFIG_IOMMU_DEBUG is not set
# CONFIG_WIREGUARD_DEBUG is not set
# CONFIG_IOSCHED_TEST is not set
# CONFIG_BRIDGE_NETFILTER is not set
# CONFIG_SCSI_UFS_TEST is not set
# CONFIG_WIL6210 is not set
# CONFIG_MSM_RDBG is not set
# CONFIG_USB_GSPCA is not set
# CONFIG_DVB_MPQ is not set
# CONFIG_MSM_11AD is not set
# CONFIG_TRACING_SUPPORT is not set
# CONFIG_CMA_DEBUGFS is not set
# CONFIG_RMNET_DATA_DEBUG_PKT is not set
# CONFIG_MSM_IDLE_STATS is not set
# CONFIG_FB_MSM_MDSS_XLOG_DEBUG is not set
# CONFIG_MSM_TZ_LOG is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_SET_MODULE_RONX is not set
# CONFIG_DEBUG_ALIGN_RODATA is not set
# CONFIG_CORESIGHT is not set
# CONFIG_BUG_ON_DATA_CORRUPTION is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_SCHED_STACK_END_CHECK is not set
# CONFIG_IPC_LOGGING is not set
# CONFIG_TRACING_EVENTS_GPIO is not set
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_ARM_SMMU_TESTBUS_DUMP is not set
# CONFIG_FIH_DEVICE_TREE_DEBUG is not set
# CONFIG_KFENCE is not set
# CONFIG_IKHEADERS is not set
# CONFIG_DEBUG_BUGVERBOSE is not set

# Simple LMK
CONFIG_ANDROID_SIMPLE_LMK=y
# CONFIG_PSI is not set
# CONFIG_MEMCG is not set
# CONFIG_HAVE_USERSPACE_LOW_MEMORY_KILLER is not set

# Boost & Latency
CONFIG_HZ_300=y
# CONFIG_HZ_100 is not set
# CONFIG_CPU_BOOST is not set
CONFIG_DEVFREQ_BOOST=y
CONFIG_DEVFREQ_INPUT_BOOST_DURATION_MS=64
CONFIG_DEVFREQ_WAKE_BOOST_DURATION_MS=1000
CONFIG_DEVFREQ_MSM_CPUBW_BOOST_FREQ=3879

# GPU memory-bus scaling (fixes "kgsl-3d0: Bus scaling not enabled")
# ADRENO_TZ builds the Adreno TZ governor; GPUBW_MON builds both the
# gpubw_mon and bw_vbif governors the kgsl "gpubw" DT node requires.
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y

# Hardening perf: base defconfig leaves INIT_ON_ALLOC on (heap alloc:on).
# Disable the always-on heap/stack zeroing for CPU/bandwidth headroom.
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set

# Timer: let little cores (CPU0-3) read CNTVCT from the vDSO instead of
# trapping clock_gettime() to EL1. Big cores still use the 858921 workaround.
CONFIG_ARM_ARCH_TIMER_VCT_ACCESS=y

# SBalance IRQ balancer (exclude top core of each 4+4 sdm636 cluster)
CONFIG_IRQ_SBALANCE=y
CONFIG_IRQ_SBALANCE_POLL_MSEC=10000
CONFIG_IRQ_SBALANCE_THRESH=1024
CONFIG_SBALANCE_EXCLUDE_CPUS="3,7"

# ZRAM 6.x backends & multi-comp (lz4 default, lzo/lzo-rle + zstd available)
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_MULTI_COMP=y

# PELT + UCLAMP + CASS + Schedutil (Tier 3)
# CONFIG_SCHED_WALT is not set
# CONFIG_SCHED_TUNE is not set
# CONFIG_SCHED_CORE_CTL is not set
# CONFIG_ENERGY_MODEL is not set
# CONFIG_LEGACY_ENERGY_MODEL_DT is not set
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_ASSIST=y
CONFIG_PELT_UTIL_HALFLIFE_16=y
CONFIG_PELT_COMPATIBILITY_LAYER=y
CONFIG_SCHED_CASS=y
CONFIG_SCHED_THERMAL_PRESSURE=y

# Hardening perf
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_FRAME_POINTER is not set

# SDM630/636/660 (Kryo 260 / A53) are ARMv8.0-A without LSE; inline LL/SC atomics directly
# CONFIG_ARM64_USE_LSE_ATOMICS is not set

# Cluster masks (0-3 LITTLE, 4-7 big)
CONFIG_LITTLE_CPU_MASK=15
CONFIG_BIG_CPU_MASK=240

# Scheduler accounting
# CONFIG_SCHEDSTATS is not set
# CONFIG_SCHED_INFO is not set
# CONFIG_PROFILING is not set
# CONFIG_AUDIT is not set
# CONFIG_QCOM_RUN_QUEUE_STATS is not set
# CONFIG_SCHED_HRTICK is not set

# Unused non-Kryo-260 (Cortex-A53/A73) CPU / timer errata
# CONFIG_CAVIUM_ERRATUM_22375 is not set
# CONFIG_CAVIUM_ERRATUM_23154 is not set
# CONFIG_CAVIUM_ERRATUM_27456 is not set
# CONFIG_CAVIUM_ERRATUM_30115 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1003 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1009 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_E1041 is not set
# CONFIG_SOCIONEXT_SYNQUACER_PREITS is not set
# CONFIG_HISILICON_ERRATUM_161600802 is not set
# CONFIG_ARM64_ERRATUM_1024718 is not set
# CONFIG_ARM64_ERRATUM_1188873 is not set
# CONFIG_ARM64_ERRATUM_1463225 is not set
# CONFIG_ARM64_ERRATUM_1542418 is not set
# CONFIG_ARM64_ERRATUM_1542419 is not set
# CONFIG_ARM64_ERRATUM_1742098 is not set
# CONFIG_ARM64_ERRATUM_3194386 is not set
# CONFIG_ARM64_ERRATUM_1286807 is not set
# CONFIG_ARM64_ERRATUM_4118414 is not set
# CONFIG_FSL_ERRATUM_A008585 is not set
# CONFIG_HISILICON_ERRATUM_161010101 is not set
# CONFIG_ARM64_ERRATUM_819472 is not set
# CONFIG_ARM64_ERRATUM_824069 is not set
# CONFIG_ARM64_ERRATUM_826319 is not set
# CONFIG_ARM64_ERRATUM_827319 is not set
# CONFIG_ARM64_ERRATUM_832075 is not set
# CONFIG_QCOM_QDF2400_ERRATUM_0065 is not set

# Non-ARMv8.0 architectural features (SDM630/636/660 are ARMv8.0-A; keep SW_TTBR0_PAN)
# CONFIG_ARM64_HW_AFDBM is not set
# CONFIG_ARM64_PAN is not set
# CONFIG_ARM64_UAO is not set
# CONFIG_ARM64_RAS_EXTN is not set
# CONFIG_ARM64_SVE is not set

# Runtime-inactive Spectre / EL2 mitigations (EL1 boot; PSCI SMCCC 1.0 lacks WA1/WA3)
# CONFIG_HARDEN_EL2_VECTORS is not set
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
# CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY is not set

# Dead hooks, unused buses/drivers & runtime stats
# CONFIG_CLEANCACHE is not set
# CONFIG_PCI is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_FB_ARMCLCD is not set
# CONFIG_FB_VIRTUAL is not set
CONFIG_BACKLIGHT_LCD_SUPPORT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# CONFIG_F2FS_STAT_FS is not set
# CONFIG_F2FS_IOSTAT is not set
# CONFIG_THERMAL_STATISTICS is not set
